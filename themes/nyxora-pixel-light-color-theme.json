  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9AA3B4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#1E9E78"
      }
    },
    {
      "name": "Regex / Escape",
      "scope": [
        "string.regexp",
        "constant.character"
      ],
      "settings": {
        "foreground": "#2E8B57"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#B05800"
      }
    },
    {
      "name": "Built-in const",
