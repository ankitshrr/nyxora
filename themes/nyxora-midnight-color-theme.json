    "string": "#65E39C",
    "keyword": "#5C94FF",
    "number": "#D2A6FF",
    "regexp": "#95E6CB",
    "operator": "#5C94FF",
    "variable": "#C5D4ED",
    "variable.readonly": "#C5D4ED",
    "parameter": "#94A6C9",
    "property": "#F47A83",
    "namespace": "#82D9FF",
    "decorator": "#F29668",
    "typeParameter": "#82D9FF",
    "label": "#5C94FF",
    "variable.constant": "#F47A83",
    "variable.defaultLibrary": "#82D9FF",
    "parameter.label:dart": "#5C94FF",
    "property:dart": "#F47A83"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#50648A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#65E39C"
      }
    },
    {
      "name": "Regex / Escape",
      "scope": [
        "string.regexp",
        "constant.character"
      ],
      "settings": {
        "foreground": "#95E6CB"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D2A6FF"
      }
    },
    {
      "name": "Built-in const",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#D2A6FF"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#C5D4ED"
      }
    },
    {
      "name": "Member Variable",
      "scope": [
        "variable.member",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#F47A83"
      }
    },
    {
      "name": "Language var",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#F47A83",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#5C94FF"
      }
    },
    {
      "name": "Storage type",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#5C94FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Lambda type",
      "scope": [
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#5C94FF"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5C94FF"
      }
    },
    {
      "name": "Accessor",
      "scope": [
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5C94FF"
      }
    },
    {
      "name": "Punctuation sep",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#50648A"
      }
    },
    {
      "name": "Punctuation sec",
      "scope": [
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#C5D4ED"
      }
    },
    {
      "name": "Template expr",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#5C94FF"
      }
    },
    {
      "name": "Embedded text",
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C5D4ED"
      }
    },
    {
      "name": "Function name",
