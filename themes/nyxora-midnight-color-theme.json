  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#82D9FF",
    "class.defaultLibrary": "#82D9FF",
    "enum": "#82D9FF",
    "enum.defaultLibrary": "#82D9FF",
    "interface": "#82D9FF",
    "interface.defaultLibrary": {
      "foreground": "#82D9FF",
      "italic": true
    },
    "struct": "#82D9FF",
    "struct.defaultLibrary": "#82D9FF",
    "type": "#82D9FF",
    "type.defaultLibrary": "#82D9FF",
    "enumMember": "#D2A6FF",
    "event": "#F29668",
    "function": "#FFB86C",
    "method": "#FFB86C",
    "macro": "#FFB86C",
